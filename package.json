{
  "name": "@chenxuan520/opencode-background-agents",
  "version": "0.1.5",
  "description": "Async background delegation plugin for OpenCode with persisted results that survive compaction",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxuan520/opencode-background-agents.git"
  },
  "homepage": "https://github.com/chenxuan520/opencode-background-agents#readme",
  "bugs": {
    "url": "https://github.com/chenxuan520/opencode-background-agents/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "background-agents",
    "delegation",
    "async",
    "agent"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/server.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.24",
    "@opencode-ai/sdk": "^1.14.24",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18",
    "opencode": "^1.0.0"
  }
}
